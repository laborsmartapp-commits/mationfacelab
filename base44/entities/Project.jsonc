{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "character_uri": {
      "type": "string"
    },
    "character_name": {
      "type": "string"
    },
    "vocal_uri": {
      "type": "string"
    },
    "vocal_name": {
      "type": "string"
    },
    "soundtrack_uri": {
      "type": "string"
    },
    "soundtrack_name": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "preview_start": {
      "type": "number",
      "default": 27
    },
    "preview_end": {
      "type": "number",
      "default": 36
    },
    "audio_offset": {
      "type": "number",
      "default": 0
    },
    "duration": {
      "type": "number"
    },
    "rig_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "selected_take_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}